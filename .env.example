# AMR-Sentinel Environment Configuration
# Copy this file to .env and fill in your values

# ── NCBI API Key (optional but recommended) ──────────────────────────────────
# Increases rate limit from 3 requests/sec to 10 requests/sec
# Get free key at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ── Backend Configuration ─────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (amr_sentinel.db in project root)
# For production: postgresql://user:password@host:5432/amr_sentinel
DATABASE_URL=sqlite:///./amr_sentinel.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
